# GEMINI_API_KEY: Required for Gemini AI item inspection API calls.
# Configure this in Render Environment Variables or AI Studio Secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The public URL where this app is hosted (optional).
APP_URL="MY_APP_URL"

# Note: Student email verification and password reset emails are delivered
# directly over HTTPS via Firebase Authentication (no SMTP credentials required).
